# Local build and test outputs.
/.build/
/dist/
/coverage/
/.cache/
*.coverprofile
*.test
*.out
*.cov

# -- project additions below this line --

# OpenTofu local state, plans and provider plugins
**/.terraform/
**/.build/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
.terraformrc
terraform.rc

