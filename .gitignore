*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Provider lock files stay local for the foundation areas and the
# hosting-platform projection areas
*/.terraform.lock.hcl
hosting-platforms/**/.terraform.lock.hcl
